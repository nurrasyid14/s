# ==============================================================================
# SuaraLens Backend - Railway Production Dockerfile (Unified PHP 8.2-FPM + Nginx)
# ==============================================================================
FROM php:8.2-fpm-alpine

# 1. Install build dependencies, PostgreSQL client, dan Nginx
RUN apk add --no-cache \
    postgresql-dev \
    postgresql-client \
    icu-dev \
    libzip-dev \
    libpng-dev \
    libjpeg-turbo-dev \
    freetype-dev \
    curl \
    bash \
    nginx

# 2. Configure and install required PHP extensions
RUN docker-php-ext-configure gd --with-freetype --with-jpeg \
    && docker-php-ext-install -j$(nproc) \
        intl \
        pdo \
        pdo_pgsql \
        pgsql \
        zip \
        gd \
        opcache

# 3. Configure production PHP settings
RUN mv "$PHP_INI_DIR/php.ini-production" "$PHP_INI_DIR/php.ini" \
    && sed -i 's/expose_php = On/expose_php = Off/' "$PHP_INI_DIR/php.ini" \
    && sed -i 's/display_errors = On/display_errors = Off/' "$PHP_INI_DIR/php.ini" \
    && sed -i 's/display_startup_errors = On/display_startup_errors = Off/' "$PHP_INI_DIR/php.ini" \
    && sed -i 's/log_errors = Off/log_errors = On/' "$PHP_INI_DIR/php.ini" \
    && sed -i 's/memory_limit = 128M/memory_limit = 256M/' "$PHP_INI_DIR/php.ini" \
    && sed -i 's/post_max_size = 8M/post_max_size = 20M/' "$PHP_INI_DIR/php.ini" \
    && sed -i 's/upload_max_filesize = 2M/upload_max_filesize = 10M/' "$PHP_INI_DIR/php.ini" \
    && echo "date.timezone = Asia/Jakarta" >> "$PHP_INI_DIR/php.ini" \
    && echo "opcache.enable=1" >> "$PHP_INI_DIR/php.ini" \
    && echo "opcache.memory_consumption=128" >> "$PHP_INI_DIR/php.ini" \
    && echo "opcache.interned_strings_buffer=8" >> "$PHP_INI_DIR/php.ini" \
    && echo "opcache.max_accelerated_files=10000" >> "$PHP_INI_DIR/php.ini" \
    && echo "opcache.revalidate_freq=0" >> "$PHP_INI_DIR/php.ini" \
    && echo "opcache.validate_timestamps=0" >> "$PHP_INI_DIR/php.ini"

# 4. Configure PHP-FPM pool for Railway
RUN echo "clear_env = no" >> /usr/local/etc/php-fpm.d/zz-docker.conf \
    && echo "catch_workers_output = yes" >> /usr/local/etc/php-fpm.d/zz-docker.conf \
    && echo "decorate_workers_output = no" >> /usr/local/etc/php-fpm.d/zz-docker.conf

WORKDIR /var/www/html

# 5. Salin source code backend
COPY backend/ /var/www/html/

# 6. Salin konfigurasi Nginx template dan entrypoint Railway
RUN mkdir -p /etc/nginx/templates
COPY deployment/nginx/railway.conf.template /etc/nginx/templates/railway.conf.template
COPY backend/docker-entrypoint.railway.sh /usr/local/bin/docker-entrypoint.railway.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.railway.sh \
    && sed -i 's/\r$//' /usr/local/bin/docker-entrypoint.railway.sh

# 7. Tetapkan hak akses least-privilege untuk www-data dan nginx
RUN chown -R www-data:www-data /var/www/html

# Port default fallback (Railway akan menyediakan nilai $PORT secara dinamis)
EXPOSE 8080

ENTRYPOINT ["/usr/local/bin/docker-entrypoint.railway.sh"]

