# SuaraLens Environment Configuration Template
# Salin file ini ke .env dan sesuaikan dengan environment Anda (local / docker / production)

# ── General Application ────────────────────────────────────────────────────────
CI_ENVIRONMENT=development
APP_BASE_URL=http://localhost:8090/
BACKEND_PORT=8090
FRONTEND_PORT=5173
ML_PORT=8000

# ── Database (PostgreSQL) ──────────────────────────────────────────────────────
POSTGRES_DB=suaralens
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_password_here
# Port PostgreSQL: Host menggunakan 5433 untuk menghindari bentrok dengan PostgreSQL lokal Windows (5432)
POSTGRES_CONTAINER_PORT=5432
POSTGRES_HOST_PORT=5433
DB_PORT_BINDING=127.0.0.1:5433

# ── Service URLs ─────────────────────────────────────────────────────────────
# ML Service internal Docker network
ML_SERVICE_URL=http://ml-service:8000

# ── Ollama / LLM Service ───────────────────────────────────────────────────────
# Perbedaan Alamat Ollama:
# - Docker container ke host machine (Local Docker Compose): http://host.docker.internal:11434
# - Local non-docker (menjalankan service langsung di OS host): http://localhost:11434
# - Cloud / Production (Railway / VPS GPU eksternal): https://your-ollama-host:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen3.5:4b
# Nonaktifkan mode "thinking" pada model reasoning (mis. Qwen 3/3.5) agar output JSON tidak terpotong.
# Opsi: none | low | medium | high; kosongkan untuk default model.
OLLAMA_REASONING_EFFORT=none
OLLAMA_API_KEY=

# ── Analytical Data Layer & Persistence Paths ─────────────────────────────────
DATA_DIR=./data
OUTPUT_DIR=./data/output
WEEKLY_ANALYTICS_OUTPUT_DIR=../data/output/weekly_analytics
ANALYTICS_DATA_LAYER_DIR=../data/output/extracted_analytics

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
