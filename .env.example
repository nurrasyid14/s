# SuaraLens Environment Variables
# Salin file ini ke .env dan isi dengan nilai yang sesuai

# ── Ollama ────────────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:4b
# Nonaktifkan mode "thinking" agar jawaban JSON tidak terpotong/kosong.
# Opsi: none | low | medium | high; kosongkan untuk default model.
OLLAMA_REASONING_EFFORT=none

# ── Data Paths ────────────────────────────────────────────────────────────────
DATA_DIR=./data
OUTPUT_DIR=./data/output
NOTEBOOKS_DIR=./notebooks

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
