# SuaraLens Environment Configuration Template
# Salin file ini ke .env dan sesuaikan dengan environment Anda (local / docker / production)

# ── General Application ────────────────────────────────────────────────────────
CI_ENVIRONMENT=development
APP_BASE_URL=http://localhost:8090/
BACKEND_PORT=8090
FRONTEND_PORT=5173
ML_PORT=8000

# ── Database (PostgreSQL) ──────────────────────────────────────────────────────
POSTGRES_DB=suaralens
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_password_here
DB_PORT_BINDING=127.0.0.1:5432

# ── Ollama / LLM Service ───────────────────────────────────────────────────────
# Untuk local host tanpa docker: http://localhost:11434
# Untuk docker container ke host machine: http://host.docker.internal:11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
# Nonaktifkan mode "thinking" pada model reasoning (mis. Qwen 3/3.5) agar output JSON tidak terpotong.
# Opsi: none | low | medium | high; kosongkan untuk default model.
OLLAMA_REASONING_EFFORT=none
OLLAMA_API_KEY=

# ── Analytical Data Layer & Persistence Paths ─────────────────────────────────
DATA_DIR=./data
OUTPUT_DIR=./data/output
WEEKLY_ANALYTICS_OUTPUT_DIR=../data/output/weekly_analytics
ANALYTICS_DATA_LAYER_DIR=../data/output/extracted_analytics

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
